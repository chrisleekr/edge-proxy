{
  "config": {
    "schema": 2,
    "kill_switch": {
      "rate_limit": false,
      "auth": false
    },
    "global": {
      "backstop": {
        "limit": 5000,
        "period": "1s",
        "burst": 10000,
        "max_entries": 1000000
      },
      "defaults": {
        "locale": false,
        "body_limit": 1048576,
        "body_read_timeout": "30s",
        "upstream_timeout": "30s",
        "responses": {
          "bad_request": "bad_request",
          "unauthorized": "unauthorized",
          "payload_too_large": "payload_too_large",
          "rate_limited": "rate_limited",
          "bad_gateway": "bad_gateway",
          "unavailable": "unavailable",
          "overloaded": "overloaded",
          "gateway_timeout": "gateway_timeout"
        }
      },
      "cors_policies": {
        "web-app": {
          "origins": [
            "https://app.example.com",
            "https://admin.example.com"
          ],
          "methods": [
            "GET",
            "POST",
            "PUT",
            "DELETE"
          ],
          "request_headers": [
            "Authorization",
            "Content-Type"
          ],
          "exposed_headers": [
            "RateLimit",
            "RateLimit-Policy"
          ],
          "credentials": true,
          "max_age": "10m"
        },
        "public-read": {
          "origins": [
            "*"
          ],
          "methods": [
            "GET"
          ],
          "request_headers": [],
          "exposed_headers": [],
          "credentials": false,
          "max_age": "1h"
        }
      },
      "responses": {
        "bad_request": {
          "status": 400,
          "content_type": "application/problem+json",
          "body": "{\"status\":400,\"title\":\"Bad Request\"}"
        },
        "unauthorized": {
          "status": 401,
          "content_type": "application/problem+json",
          "body": "{\"status\":401,\"title\":\"Unauthorized\"}"
        },
        "payload_too_large": {
          "status": 413,
          "content_type": "application/problem+json",
          "body": "{\"status\":413,\"title\":\"Request Entity Too Large\"}"
        },
        "rate_limited": {
          "status": 429,
          "content_type": "application/problem+json",
          "body": "{\"status\":429,\"title\":\"Too Many Requests\"}"
        },
        "bad_gateway": {
          "status": 502,
          "content_type": "application/problem+json",
          "body": "{\"status\":502,\"title\":\"Bad Gateway\"}"
        },
        "unavailable": {
          "status": 503,
          "content_type": "application/problem+json",
          "body": "{\"status\":503,\"title\":\"Service Unavailable\"}"
        },
        "overloaded": {
          "status": 503,
          "content_type": "application/problem+json",
          "body": "{\"status\":503,\"title\":\"Service Unavailable\"}"
        },
        "gateway_timeout": {
          "status": 504,
          "content_type": "application/problem+json",
          "body": "{\"status\":504,\"title\":\"Gateway Timeout\"}"
        },
        "friendly-429": {
          "status": 429,
          "content_type": "text/html; charset=utf-8",
          "body": "<!doctype html><title>Slow down</title><h1>Too many requests</h1><p>Try again in {{retry_after}} seconds.</p><p><small>Request {{request_id}}</small></p>"
        },
        "json-429": {
          "status": 429,
          "content_type": "application/problem+json",
          "body": "{\"status\":{{status}},\"title\":\"Too Many Requests\",\"retry_after\":{{retry_after}},\"request_id\":\"{{request_id}}\"}"
        }
      },
      "locale": {
        "supported": [
          "en",
          "fr",
          "de",
          "ko"
        ],
        "default": "en",
        "output_header": "X-Edge-Locale"
      },
      "request_headers": {
        "forward": {
          "mode": "denylist",
          "names": [
            "X-Internal-Debug"
          ]
        }
      }
    },
    "auth": {
      "issuers": [
        {
          "id": "idp",
          "issuer": "https://idp",
          "audiences": [
            "loadtest"
          ],
          "jwks_url": "https://idp:8443/jwks.json",
          "algorithm": "ES256"
        },
        {
          "id": "partner-idp",
          "issuer": "https://idp/partner",
          "audiences": [
            "partner"
          ],
          "jwks_url": "https://idp:8443/jwks.json",
          "algorithm": "ES256"
        }
      ],
      "default_accepted": [
        "idp"
      ]
    },
    "config_rules": [
      {
        "id": "private-needs-auth",
        "expression": {
          "combinator": "and",
          "rules": [
            {
              "field": "http.request.uri.path",
              "operator": "starts_with",
              "value": "/private/"
            }
          ]
        },
        "settings": {
          "auth": {
            "mode": "required"
          }
        }
      },
      {
        "id": "api-defaults",
        "expression": {
          "combinator": "and",
          "rules": [
            {
              "field": "http.request.uri.path",
              "operator": "starts_with",
              "value": "/api/"
            }
          ]
        },
        "settings": {
          "auth": {
            "mode": "optional"
          },
          "cors_policy": "web-app",
          "upstream_timeout": "10s",
          "ratelimit_headers": true,
          "responses": {
            "rate_limited": "json-429"
          }
        }
      },
      {
        "id": "public-catalog",
        "expression": {
          "combinator": "and",
          "rules": [
            {
              "field": "http.request.uri.path",
              "operator": "starts_with",
              "value": "/api/catalog/"
            }
          ]
        },
        "settings": {
          "cors_policy": "public-read"
        }
      },
      {
        "id": "uploads",
        "expression": {
          "combinator": "and",
          "rules": [
            {
              "field": "http.request.uri.path",
              "operator": "starts_with",
              "value": "/api/upload"
            }
          ]
        },
        "settings": {
          "body_limit": 10485760,
          "upstream_timeout": "60s"
        }
      },
      {
        "id": "partner-api",
        "expression": {
          "combinator": "and",
          "rules": [
            {
              "field": "http.request.uri.path",
              "operator": "starts_with",
              "value": "/api/partner/"
            }
          ]
        },
        "settings": {
          "auth": {
            "mode": "required",
            "accepted": [
              "partner-idp"
            ]
          }
        }
      },
      {
        "id": "pages",
        "expression": {
          "combinator": "and",
          "rules": [
            {
              "field": "http.request.uri.path",
              "operator": "starts_with",
              "value": "/pages/"
            }
          ]
        },
        "settings": {
          "locale": true,
          "responses": {
            "rate_limited": "friendly-429"
          }
        }
      },
      {
        "id": "login-page",
        "expression": {
          "combinator": "and",
          "rules": [
            {
              "field": "http.request.uri.path",
              "operator": "eq",
              "value": "/login"
            }
          ]
        },
        "settings": {
          "responses": {
            "rate_limited": "friendly-429"
          }
        }
      }
    ],
    "rate_limit_rules": [
      {
        "id": "login-per-ip",
        "expression": {
          "combinator": "and",
          "rules": [
            {
              "field": "http.request.uri.path",
              "operator": "eq",
              "value": "/login"
            }
          ]
        },
        "on_missing_key": "fallback_ip",
        "action": "block",
        "fail_mode": "closed",
        "key": [
          "ip"
        ],
        "algorithm": "sliding_window",
        "limit": 2,
        "period": "1m",
        "penalty": "1m"
      },
      {
        "id": "api-burst",
        "expression": {
          "combinator": "and",
          "rules": [
            {
              "field": "http.request.uri.path",
              "operator": "starts_with",
              "value": "/api/"
            }
          ]
        },
        "on_missing_key": "fallback_ip",
        "action": "block",
        "fail_mode": "open",
        "key": [
          "ip"
        ],
        "algorithm": "token_bucket",
        "limit": 20,
        "period": "1m",
        "burst": 10
      },
      {
        "id": "pages-per-ip",
        "expression": {
          "combinator": "and",
          "rules": [
            {
              "field": "http.request.uri.path",
              "operator": "starts_with",
              "value": "/pages/"
            }
          ]
        },
        "on_missing_key": "fallback_ip",
        "action": "block",
        "fail_mode": "local",
        "key": [
          "ip"
        ],
        "algorithm": "fixed_window",
        "limit": 1000,
        "period": "1m"
      },
      {
        "id": "api-per-user",
        "expression": {
          "combinator": "and",
          "rules": [
            {
              "field": "http.request.uri.path",
              "operator": "starts_with",
              "value": "/api/"
            }
          ]
        },
        "on_missing_key": "skip",
        "action": "block",
        "fail_mode": "open",
        "key": [
          "jwt_claim:sub"
        ],
        "algorithm": "leaky_bucket",
        "limit": 600,
        "period": "1m",
        "burst": 60
      },
      {
        "id": "partner-per-key",
        "expression": {
          "combinator": "and",
          "rules": [
            {
              "field": "http.request.uri.path",
              "operator": "starts_with",
              "value": "/api/partner/"
            }
          ]
        },
        "on_missing_key": "reject",
        "action": "block",
        "fail_mode": "open",
        "key": [
          "header:X-Api-Key",
          "ip"
        ],
        "algorithm": "sliding_window",
        "limit": 100,
        "period": "1m"
      },
      {
        "id": "api-shadow",
        "expression": {
          "combinator": "and",
          "rules": [
            {
              "field": "http.request.uri.path",
              "operator": "starts_with",
              "value": "/api/"
            }
          ]
        },
        "on_missing_key": "fallback_ip",
        "action": "log",
        "fail_mode": "open",
        "key": [
          "ip"
        ],
        "algorithm": "sliding_window",
        "limit": 10,
        "period": "1m",
        "penalty": "1m"
      }
    ],
    "request_header_rules": [
      {
        "id": "tag-service",
        "expression": {
          "combinator": "and",
          "rules": [
            {
              "field": "http.request.uri.path",
              "operator": "starts_with",
              "value": "/api/"
            }
          ]
        },
        "ops": [
          {
            "op": "set",
            "name": "X-Service",
            "value": "api"
          }
        ]
      },
      {
        "id": "drop-debug",
        "expression": {
          "combinator": "and",
          "rules": []
        },
        "ops": [
          {
            "op": "remove",
            "name": "X-Debug"
          }
        ]
      },
      {
        "id": "legacy-token",
        "expression": {
          "combinator": "and",
          "rules": [
            {
              "field": "http.request.uri.path",
              "operator": "starts_with",
              "value": "/api/partner/"
            }
          ]
        },
        "ops": [
          {
            "op": "rename",
            "from": "X-Legacy-Key",
            "to": "X-Api-Key"
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "name": "login is limited per IP",
      "request": {
        "host": "api.example.com",
        "path": "/login",
        "method": "POST"
      },
      "expect": {
        "rate_limit_rules": [
          "login-per-ip"
        ],
        "config_rules": [
          "login-page"
        ]
      }
    },
    {
      "name": "private paths need a token",
      "request": {
        "host": "api.example.com",
        "path": "/private/x"
      },
      "expect": {
        "config_rules": [
          "private-needs-auth"
        ]
      }
    },
    {
      "name": "anonymous API calls get the API defaults and the per-IP limits",
      "request": {
        "host": "api.example.com",
        "path": "/api/items"
      },
      "expect": {
        "config_rules": [
          "api-defaults"
        ],
        "rate_limit_rules": [
          "api-burst",
          "api-shadow"
        ]
      }
    },
    {
      "name": "signed-in API calls are also limited per user",
      "request": {
        "host": "api.example.com",
        "path": "/api/orders",
        "jwt_claims": {
          "sub": "user-1"
        }
      },
      "expect": {
        "rate_limit_rules": [
          "api-burst",
          "api-per-user",
          "api-shadow"
        ]
      }
    },
    {
      "name": "pages pick a locale and their own limit",
      "request": {
        "host": "api.example.com",
        "path": "/pages/home"
      },
      "expect": {
        "config_rules": [
          "pages"
        ],
        "rate_limit_rules": [
          "pages-per-ip"
        ]
      }
    }
  ]
}